# ─────────────────────────────────────────────
# 환경 변수 템플릿 (이 파일은 커밋됩니다)
# 실제 값은 .env.local 에 넣고, 배포 값은 Vercel 대시보드에 등록하세요.
# ─────────────────────────────────────────────

# 관리자 로그인
ADMIN_USERNAME=your-admin-id
ADMIN_PASSWORD=your-strong-password
ADMIN_SECRET=generate-a-long-random-string

# 레거시 FTP 업로드 서버(server.js)용 (선택)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
SESSION_SECRET=

# Vercel KV (스토어 연결 시 자동 주입 / 로컬은 `vercel env pull` 로 받아옴)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
